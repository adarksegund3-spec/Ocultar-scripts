        if pg then
                pcall(function()
                        local tg = pg:FindFirstChild(TUTORIAL_GUI)
                        if tg then
                                for _, d in ipairs(tg:GetDescendants()) do
                                        if d:GetAttribute(TAG) then d:Destroy() end
                                end
                        end
                end)
        end
end

-- guis do proprio roblox, nao mexe
local ROBLOX_EXACT = {
        RobloxGui = true, TopBarApp = true, TopBar = true, PlayerList = true,
        Chat = true, ExperienceChat = true, BubbleChat = true,
        PurchasePromptApp = true, ThemeProvider = true, DevConsoleMaster = true,
        VoiceChat = true, TeleportGui = true, TeleportEffectGui = true,
        ImmersiveBrandedAds = true, CaptureOverlay = true, ScreenshotsCarousel = true,
        CaptureManager = true, ShortcutBar = true, drawingDirectory = true,
        _FullscreenTestGui = true, _DeviceTestGui = true, SystemScrim = true,
        RewardedVideoAdPlayer = true, MomentsCreationFlow = true,
}
local ROBLOX_PREFIX = { "Roblox", "InExperience", "HeadsetDisconnected", "Foundation" }

local function isRobloxName(n)
        if ROBLOX_EXACT[n] then return true end
        for _, p in ipairs(ROBLOX_PREFIX) do
                if n:sub(1, #p) == p then return true end
        end
        return false
end

local function garbled(name)
        return name:find("[^\32-\126]") ~= nil
end

-- no arceus o gethui fica dentro de um screengui do coregui, esse nao pode sumir inteiro
local function isHolder(sg, hui)
        return hui ~= nil and (hui == sg or hui:IsDescendantOf(sg))
end

local function nameMatches(name)
        if EXTRA_NAMES[name] then return true end
        local l = name:lower()
        for _, p in ipairs(DRIP_PREFIX) do
                if l:sub(1, #p) == p then return true end
        end
        for _, p in ipairs(DRIP_CONTAINS) do
                if l:find(p, 1, true) then return true end
        end
        return false
end

local function hasArceus(s)
        return type(s) == "string" and s:lower():find("arceus", 1, true) ~= nil
end

local function hasArceusContent(sg)
        local ok, desc = pcall(function() return sg:GetDescendants() end)
        if not ok then return false end
        for i, d in ipairs(desc) do
                local okN, found = pcall(function()
                        if hasArceus(d.Name) then return true end
                        if (d:IsA("TextLabel") or d:IsA("TextButton")) and hasArceus(d.Text) then return true end
                        return false
                end)
                if okN and found then return true end
                if i % 1500 == 0 then task.wait() end
        end
        return false
end

local arcCache = setmetatable({}, { __mode = "k" })

local function isArceus(sg, allowScan)
        local c = arcCache[sg]
        if c ~= nil then return c end
        -- nome estranho + display order gigante
        local okO, ord = pcall(function() return sg.DisplayOrder end)
        if garbled(sg.Name) and okO and type(ord) == "number" and ord >= 1000000000 then
                arcCache[sg] = true
                return true
        end
        if not allowScan then return false end
        local res = hasArceusContent(sg)
        arcCache[sg] = res
        return res
end

local function isTarget(sg, allowScan)
        if nameMatches(sg.Name) then return true end
        return isArceus(sg, allowScan)
end

local function findTargets()
        local found, seen = {}, {}
        local hui = getHui()
        for _, root in ipairs(getExecRoots()) do
                local ok, kids = pcall(function() return root:GetChildren() end)
                if ok then
                        for _, sg in ipairs(kids) do
                                if sg:IsA("ScreenGui") and not seen[sg]
                                        and not isHolder(sg, hui) and not isRobloxName(sg.Name) then
                                        -- no coregui so o teste rapido, sem varrer o conteudo
                                        local okA, res = pcall(isTarget, sg, root ~= CoreGui)
                                        if okA and res then
                                                seen[sg] = true
                                                table.insert(found, sg)
                                        end
                                end
                        end
                end
        end
        return found
end

-- ocultar / mostrar
local alive = true
local hidden, busy = false, false
local active = {}
local handled = {}
local hbConn = nil
local addConns = {}

local refreshUI = nil
local flashMsg = nil

local function snap(inst, top, withT)
        local e = { inst = inst, props = {}, vals = {}, top = top }

        if withT then
                local names = {}
                if inst:IsA("GuiObject") then
                        table.insert(names, "BackgroundTransparency")
                        if inst:IsA("ImageLabel") or inst:IsA("ImageButton") then
                                table.insert(names, "ImageTransparency")
                        end
                        if inst:IsA("TextLabel") or inst:IsA("TextButton") or inst:IsA("TextBox") then
                                table.insert(names, "TextTransparency")
                                table.insert(names, "TextStrokeTransparency")
                        end
                elseif inst:IsA("UIStroke") then
                        table.insert(names, "Transparency")
                end
                for _, n in ipairs(names) do
                        local ok, v = pcall(function() return inst[n] end)
                        if ok and type(v) == "number" and v ~= 1 then
                                e.props[n] = v
                                e.vals[n] = 1
                        end
                end
        end

        if top then
                if inst:IsA("ScreenGui") then
                        local ok, v = pcall(function() return inst.Enabled end)
                        if ok then e.props.Enabled = v e.vals.Enabled = false end
                elseif inst:IsA("GuiObject") then
                        local ok1, v1 = pcall(function() return inst.Visible end)
                        local ok2, v2 = pcall(function() return inst.Position end)
                        if ok1 then e.props.Visible = v1 e.vals.Visible = false end
                        if ok2 then e.props.Position = v2 e.vals.Position = FAR end
                end
        end
        return e
end

local function collectSG(sg, out)
        local first = snap(sg, true, false)
        if next(first.props) ~= nil then table.insert(out, first) end

        local ok, desc = pcall(function() return sg:GetDescendants() end)
        if not ok then return end
        for i, d in ipairs(desc) do
                -- topo = screengui aninhado ou guiobject cujo pai nao e guiobject
                local okT, top = pcall(function()
                        if d:IsA("ScreenGui") then return true end
                        return d:IsA("GuiObject") and not d.Parent:IsA("GuiObject")
                end)
                top = (okT and top) or false
                if top or i <= 300 then
                        local okS, e = pcall(snap, d, top, i <= 300)
                        if okS and next(e.props) ~= nil then table.insert(out, e) end
                end
                if i % 400 == 0 then task.wait() end
        end
end

local function apply(e)
        for n, v in pairs(e.vals) do
                local ok, cur = pcall(function() return e.inst[n] end)
                if ok and cur ~= v then
                        pcall(function() e.inst[n] = v end)
                end
        end
end

local function restore(e)
        for n, v in pairs(e.props) do
                pcall(function() e.inst[n] = v end)
        end
end

local function stopEnforce()
        if hbConn then
                pcall(function() hbConn:Disconnect() end)
                hbConn = nil
        end
        for _, c in ipairs(addConns) do
                pcall(function() c:Disconnect() end)
        end
        addConns = {}
end

local function startEnforce()
        local frames = 0
        hbConn = RunService.Heartbeat:Connect(function()
                if not hidden or busy then return end
                frames += 1
                local full = (frames % 30 == 0)
                for _, e in ipairs(active) do
                        if e.top or full then apply(e) end
                end
        end)

        -- menu aberto depois tambem some
        for _, root in ipairs(getExecRoots()) do
                local ok, c = pcall(function()
                        return root.ChildAdded:Connect(function(sg)
                                task.spawn(function()
                                        task.wait(0.4)
                                        if not hidden or busy or handled[sg] then return end
                                        if not sg:IsA("ScreenGui") or isRobloxName(sg.Name) then return end
                                        if isHolder(sg, getHui()) then return end
                                        local okA, res = pcall(isTarget, sg, root ~= CoreGui)
                                        if okA and res then
                                                handled[sg] = true
                                                local add = {}
                                                collectSG(sg, add)
                                                for _, e in ipairs(add) do
                                                        table.insert(active, e)
                                                        apply(e)
                                                end
                                        end
                                end)
                        end)
                end)
                if ok then table.insert(addConns, c) end
        end
end

local function hideNow()
        if busy or hidden then return end
        busy = true
        if refreshUI then refreshUI() end
        task.spawn(function()
                local ok = pcall(function()
                        local okF, sgs = pcall(findTargets)
                        if not okF then sgs = {} end

                        local out = {}
                        handled = {}
                        for _, sg in ipairs(sgs) do
                                handled[sg] = true
                                collectSG(sg, out)
                        end

                        if #out == 0 then
                                busy = false
                                if flashMsg then flashMsg("Nenhum menu encontrado") end
                                return
                        end

                        active = out
                        for i, e in ipairs(active) do
                                apply(e)
                                if i % 400 == 0 then task.wait() end
                        end

                        hidden = true
                        startEnforce()
                end)
                if not ok and not hidden then
                        -- deu erro no meio, volta tudo
                        for _, e in ipairs(active) do restore(e) end
                        active = {}
                        handled = {}
                end
                busy = false
                if refreshUI then refreshUI() end
        end)
end

local function showNow()
        if busy or not hidden then return end
        busy = true
        hidden = false
        stopEnforce()
        if refreshUI then refreshUI() end
        task.spawn(function()
                for i, e in ipairs(active) do
                        restore(e)
                        if i % 400 == 0 then task.wait() end
                end
                active = {}
                handled = {}
                busy = false
                if refreshUI then refreshUI() end
        end)
end

local function toggle()
        if busy then return end
        if hidden then showNow() else hideNow() end
end

-- painel dentro da janela do tutorial
local panel, panelMain, panelBg, panelTg = nil, nil, nil, nil
local btn, question = nil, nil
local panelConns = {}
local flashText, flashUntil = nil, 0

refreshUI = function()
        if not btn or not question or not btn.Parent then return end
        local qText = hidden and "Drip menu oculto" or "Deseja ocultar o drip menu?"
        local bText = hidden and "Mostrar" or "Sim"
        local bCol = hidden and RED or GREEN
        if busy then
                bText = "..."
                bCol = GREY
        end
        if flashText and os.clock() < flashUntil then
                qText = flashText
        end
        question.Text = qText
        btn.Text = bText
        TweenService:Create(btn, TweenInfo.new(0.2), { BackgroundColor3 = bCol }):Play()
end

flashMsg = function(t)
        flashText = t
        flashUntil = os.clock() + 2.5
        refreshUI()
        task.delay(2.6, function()
                if alive then refreshUI() end
        end)
end

-- encaixa o painel embaixo do cartao da janela (so escala, acompanha a animacao)
local function layout()
        if not panel or not panel.Parent or not panelMain or not panelBg then return end
        local ok = pcall(function()
                local mA, bA = panelMain.AbsoluteSize, panelBg.AbsoluteSize
                if mA.X < 1 or mA.Y < 1 or bA.X < 1 or bA.Y < 1 then return end
                local rel = panelBg.AbsolutePosition - panelMain.AbsolutePosition
                panel.Position = UDim2.new(
                        rel.X / mA.X, 0,
                        (rel.Y + bA.Y * (1 + PANEL_GAP)) / mA.Y, 0
                )
                panel.Size = UDim2.new(bA.X / mA.X, 0, (bA.Y * PANEL_HEIGHT) / mA.Y, 0)
                panel.Visible = true
        end)
        return ok
end

local function destroyPanel()
        for _, c in ipairs(panelConns) do
                pcall(function() c:Disconnect() end)
        end
        panelConns = {}
        if panel then
                pcall(function() panel:Destroy() end)
        end
        panel, panelMain, panelBg, panelTg = nil, nil, nil, nil
        btn, question = nil, nil
end

local function addPadding(parent, v)
        local pad = Instance.new("UIPadding")
        pad.PaddingTop = UDim.new(v, 0)
        pad.PaddingBottom = UDim.new(v, 0)
        pad.Parent = parent
end

local function buildPanel(tg, main, bg)
        panelTg, panelMain, panelBg = tg, main, bg

        local p = Instance.new("ImageLabel")
        p.Name = tostring(math.random(100000, 999999))
        p:SetAttribute(TAG, true)
        p.BackgroundColor3 = Color3.fromRGB(16, 16, 24)
        p.BackgroundTransparency = 0.05
        p.BorderSizePixel = 0
        p.Image = ""
        -- copia o visual do Background do jogo
        for _, n in ipairs({
                "BackgroundColor3", "BackgroundTransparency", "Image", "ImageColor3",
                "ImageTransparency", "ScaleType", "SliceCenter", "SliceScale", "ResampleMode",
        }) do
                pcall(function() p[n] = bg[n] end)
        end
        for _, cls in ipairs({ "UICorner", "UIStroke", "UIGradient" }) do
                local ref = bg:FindFirstChildOfClass(cls)
                if ref then
                        pcall(function() ref:Clone().Parent = p end)
                end
        end
        if not p:FindFirstChildOfClass("UICorner") then
                local c = Instance.new("UICorner")
                c.CornerRadius = UDim.new(0, 8)
                c.Parent = p
        end
        p.ZIndex = 20
        p.LayoutOrder = 9999
        p.Visible = false
        p.Size = UDim2.new(0.46, 0, 0.14, 0)
        p.Position = UDim2.new(0.27, 0, 0.7, 0)

        -- mesma fonte do titulo da janela
        local ref = bg:FindFirstChild("Title", true)

        local q = Instance.new("TextLabel")
        q.BackgroundTransparency = 1
        q.Position = UDim2.new(0.05, 0, 0.06, 0)
        q.Size = UDim2.new(0.9, 0, 0.38, 0)
        q.TextScaled = true
        q.TextWrapped = true
        q.TextColor3 = WHITE
        q.Font = Enum.Font.GothamBold
        q.Text = "Deseja ocultar o drip menu?"
        q.ZIndex = 21
        if ref and ref:IsA("TextLabel") then
                pcall(function() q.FontFace = ref.FontFace end)
        end
        addPadding(q, 0.08)
        q.Parent = p

        local b = Instance.new("TextButton")
        b.Position = UDim2.new(0.08, 0, 0.52, 0)
        b.Size = UDim2.new(0.84, 0, 0.4, 0)
        b.BackgroundColor3 = GREEN
        b.BorderSizePixel = 0
        b.AutoButtonColor = false
        b.TextScaled = true
        b.TextColor3 = WHITE
        b.Font = Enum.Font.GothamBold
        b.Text = "Sim"
        b.ZIndex = 21
        if ref and ref:IsA("TextLabel") then
                pcall(function() b.FontFace = ref.FontFace end)
        end
        local bc = Instance.new("UICorner")
        bc.CornerRadius = UDim.new(0.3, 0)
        bc.Parent = b
        addPadding(b, 0.14)
        b.Parent = p

        panel, question, btn = p, q, b
        p.Parent = main

        table.insert(panelConns, b.Activated:Connect(toggle))
        table.insert(panelConns, main:GetPropertyChangedSignal("AbsoluteSize"):Connect(layout))
        table.insert(panelConns, bg:GetPropertyChangedSignal("AbsoluteSize"):Connect(layout))
        table.insert(panelConns, tg:GetPropertyChangedSignal("Enabled"):Connect(function()
                layout()
                task.delay(0.1, layout)
        end))

        refreshUI()
        layout()
end

local function ensurePanel()
        if panel and panel.Parent and panel:IsDescendantOf(game) then
                layout()
                return
        end
        if panel then destroyPanel() end

        local pg = getPlayerGui()
        local tg = pg and pg:FindFirstChild(TUTORIAL_GUI)
        if not tg then return end
        local main = tg:FindFirstChild(MAIN_NAME, true)
        local bg = main and main:FindFirstChild(BG_NAME, true)
        if main and bg then
                buildPanel(tg, main, bg)
        end
end

-- se a janela for recriada (respawn) o painel volta
task.spawn(function()
        while alive do
                pcall(ensurePanel)
                task.wait(0.25)
        end
end)

-- aquece a deteccao pro primeiro clique nao demorar
task.spawn(function()
        pcall(findTargets)
end)

env.__OCS_CLEAN = function()
        alive = false
        hidden = false
        stopEnforce()
        for _, e in ipairs(active) do restore(e) end
        active = {}
        destroyPanel()
end