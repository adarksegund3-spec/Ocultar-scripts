-- Detecção dos menus de scripts
-- Tudo que fica nos contêineres do executor (gethui / CoreGui) e NÃO é
-- do próprio Roblox. O PlayerGui do jogo nunca é tocado.
---------------------------------------------------------------------
local ROBLOX_EXACT = {
	RobloxGui = true, TopBarApp = true, TopBar = true, PlayerList = true,
	Chat = true, ExperienceChat = true, BubbleChat = true,
	PurchasePromptApp = true, ThemeProvider = true, DevConsoleMaster = true,
	VoiceChat = true, TeleportGui = true, TeleportEffectGui = true,
	ImmersiveBrandedAds = true, CaptureOverlay = true, ScreenshotsCarousel = true,
	CaptureManager = true, ShortcutBar = true, drawingDirectory = true,
	_FullscreenTestGui = true, _DeviceTestGui = true, SystemScrim = true,
	RewardedVideoAdPlayer = true, MomentsCreationFlow = true,
}
local ROBLOX_PREFIX = { "Roblox", "InExperience", "HeadsetDisconnected", "Foundation" }

local function isRobloxName(n)
	if ROBLOX_EXACT[n] then return true end
	for _, p in ipairs(ROBLOX_PREFIX) do
		if n:sub(1, #p) == p then return true end
	end
	return false
end

local function garbled(name)
	return name:find("[^\32-\126]") ~= nil
end

-- (não inclui este script; ele é adicionado manualmente na hora de ocultar)
local function shouldHide(sg)
	if not sg:IsA("ScreenGui") or isOurs(sg) or isRobloxName(sg.Name) then return false end
	local ok, kids = pcall(function() return sg:GetChildren() end)
	return ok and #kids > 0
end

-- para GUIs novas no CoreGui exige cara de script (nome aleatório / ordem altíssima)
local function shouldHideNew(root, sg)
	if not shouldHide(sg) then return false end
	if root ~= CoreGui then return true end
	local n = sg.Name
	local okO, ord = pcall(function() return sg.DisplayOrder end)
	local randomLike = #n <= 10 and n:find("%d") ~= nil and n:find("%a") ~= nil
	return garbled(n) or randomLike or (okO and type(ord) == "number" and ord >= 1000000000)
end

local function findScripts()
	local found = {}
	for _, root in ipairs(getExecRoots()) do
		local ok, kids = pcall(function() return root:GetChildren() end)
		if ok then
			for _, sg in ipairs(kids) do
				local okA, res = pcall(shouldHide, sg)
				if okA and res then table.insert(found, sg) end
			end
		end
	end
	return found
end

local function hasArceus(s)
	return type(s) == "string" and s:lower():find("arceus", 1, true) ~= nil
end

local function hasArceusContent(sg)
	local ok, desc = pcall(function() return sg:GetDescendants() end)
	if not ok then return false end
	for i, d in ipairs(desc) do
		local okN, found = pcall(function()
			if hasArceus(d.Name) then return true end
			if (d:IsA("TextLabel") or d:IsA("TextButton")) and hasArceus(d.Text) then return true end
			return false
		end)
		if okN and found then return true end
		if i % 1500 == 0 then task.wait() end
	end
	return false
end

-- tenta usar a imagem real da logo do Arceus na logo redonda
local function findLogoImage(sgs)
	local counts, cands = {}, {}
	for _, sg in ipairs(sgs) do
		local ok, desc = pcall(function() return sg:GetDescendants() end)
		if ok then
			for i, d in ipairs(desc) do
				if d:IsA("ImageLabel") or d:IsA("ImageButton") then
					local okI, img = pcall(function() return d.Image end)
					if okI and type(img) == "string" and img ~= "" then
						counts[img] = (counts[img] or 0) + 1
						table.insert(cands, { d = d, img = img, sg = sg })
					end
				end
				if i % 1500 == 0 then task.wait() end
			end
		end
	end

	local cam = workspace.CurrentCamera
	local vp = cam and cam.ViewportSize or Vector2.new(960, 480)
	local best, bestScore = nil, 4

	for _, c in ipairs(cands) do
		if counts[c.img] == 1 then
			local d = c.d
			local ok, sc = pcall(function()
				local s, p = d.AbsoluteSize, d.AbsolutePosition
				if s.X < 30 or s.Y < 30 or s.X > 300 or s.Y > 300 then return 0 end
				local ratio = s.X / s.Y
				if ratio < 0.85 or ratio > 1.2 then return 0 end
				local depth, x = 0, d
				while x.Parent and x.Parent ~= c.sg do
					depth += 1
					x = x.Parent
				end
				local score = 0
				if d:IsA("ImageButton") then score += 3 end
				if depth <= 1 then score += 2 elseif depth <= 3 then score += 1 end
				if p.X < vp.X * 0.06 or (vp.X - (p.X + s.X)) < vp.X * 0.06 then score += 2 end
				if d.Visible then score += 1 end
				return score
			end)
			if ok and sc > bestScore then
				best, bestScore = d, sc
			end
		end
	end

	if best then
		local ok = pcall(function()
			logoImg.Image = best.Image
			logoImg.ImageRectOffset = best.ImageRectOffset
			logoImg.ImageRectSize = best.ImageRectSize
			logoImg.Visible = true
			glyph.Visible = false
		end)
		if not ok then
			logoImg.Visible = false
			glyph.Visible = true
		end
	end
end

---------------------------------------------------------------------
-- Motor de ocultação
---------------------------------------------------------------------
local mode = "remover" -- "remover" | "camuflar"
local hidden, busy = false, false
local active = {}
local handled = {}
local hbConn = nil
local addConns = {}
local rr = 1

local function setStatus(t) statusLbl.Text = t end

local function snap(inst, top, md)
	local e = { inst = inst, props = {}, vals = {}, top = top }
	local names = {}
	if inst:IsA("GuiObject") then
		table.insert(names, "BackgroundTransparency")
		if inst:IsA("ImageLabel") or inst:IsA("ImageButton") then
			table.insert(names, "ImageTransparency")
		end
		if inst:IsA("TextLabel") or inst:IsA("TextButton") or inst:IsA("TextBox") then
			table.insert(names, "TextTransparency")
			table.insert(names, "TextStrokeTransparency")
		end
	elseif inst:IsA("UIStroke") then
		table.insert(names, "Transparency")
	end

	for _, n in ipairs(names) do
		local ok, v = pcall(function() return inst[n] end)
		if ok and type(v) == "number" then
			local nv = (md == "remover") and 1 or math.max(v, CAMO)
			if nv ~= v then
				e.props[n] = v
				e.vals[n] = nv
			end
		end
	end

	if md == "remover" and top then
		if inst:IsA("ScreenGui") then
			local ok, v = pcall(function() return inst.Enabled end)
			if ok then e.props.Enabled = v e.vals.Enabled = false end
		elseif inst:IsA("GuiObject") then
			local ok1, v1 = pcall(function() return inst.Visible end)
			local ok2, v2 = pcall(function() return inst.Position end)
			if ok1 then e.props.Visible = v1 e.vals.Visible = false end
			if ok2 then e.props.Position = v2 e.vals.Position = FAR end
		end
	end
	return e
end

local function collectSG(sg, md, out)
	local first = snap(sg, true, md)
	if next(first.props) ~= nil then table.insert(out, first) end

	local ok, desc = pcall(function() return sg:GetDescendants() end)
	if not ok then return end
	local limit = (md == "remover") and math.min(300, #desc) or #desc
	for i = 1, limit do
		local d = desc[i]
		local okS, e = pcall(snap, d, (md == "remover") and d.Parent == sg, md)
		if okS and next(e.props) ~= nil then table.insert(out, e) end
		if i % 400 == 0 then task.wait() end
	end
end

local function apply(e)
	for n, v in pairs(e.vals) do
		local ok, cur = pcall(function() return e.inst[n] end)
		if ok and cur ~= v then
			pcall(function() e.inst[n] = v end)
		end
	end
end

local function restore(e)
	for n, v in pairs(e.props) do
		pcall(function() e.inst[n] = v end)
	end
end

local function stopEnforce()
	if hbConn then
		pcall(function() hbConn:Disconnect() end)
		hbConn = nil
	end
	for _, c in ipairs(addConns) do
		pcall(function() c:Disconnect() end)
	end
	addConns = {}
end

local function startEnforce()
	local frames = 0
	hbConn = RunService.Heartbeat:Connect(function()
		if not hidden or busy then return end
		frames += 1
		if mode == "remover" then
			local full = (frames % 30 == 0)
			for _, e in ipairs(active) do
				if e.top or full then apply(e) end
			end
		else
			local n = #active
			if n == 0 then return end
			for _ = 1, CAMO_STEP do
				if rr > n then rr = 1 end
				apply(active[rr])
				rr += 1
			end
		end
	end)

	-- menus de scripts abertos depois também somem
	for _, root in ipairs(getExecRoots()) do
		local ok, c = pcall(function()
			return root.ChildAdded:Connect(function(sg)
				task.spawn(function()
					task.wait(0.4)
					if not hidden or busy or handled[sg] then return end
					local okA, res = pcall(shouldHideNew, root, sg)
					if okA and res then
						handled[sg] = true
						local add = {}
						collectSG(sg, mode, add)
						for _, e in ipairs(add) do
							table.insert(active, e)
							apply(e)
						end
					end
				end)
			end)
		end)
		if ok then table.insert(addConns, c) end
	end
end

local function styleToggle()
	if hidden then
		toggleBtn.Text = "Mostrar"
		tw(toggleBtn, { BackgroundColor3 = OK_GREEN }, 0.3, Enum.EasingStyle.Sine)
		tw(logoStroke, { Color = OK_GREEN }, 0.3, Enum.EasingStyle.Sine)
	else
		toggleBtn.Text = "Ocultar"
		tw(toggleBtn, { BackgroundColor3 = ACCENT }, 0.3, Enum.EasingStyle.Sine)
		tw(logoStroke, { Color = ACCENT }, 0.3, Enum.EasingStyle.Sine)
	end
end

local function hideNow()
	if busy or hidden then return end
	busy = true
	setStatus("Procurando scripts...")
	task.spawn(function()
		local sgs = findScripts()
		if #sgs == 0 then
			setStatus("Nenhum menu de script encontrado.")
			busy = false
			return
		end

		local count = #sgs
		-- no modo camuflar este próprio script também entra na ocultação
		-- (no modo remover ele fica visível, senão não dá para voltar)
		if mode == "camuflar" then
			table.insert(sgs, gui)
		end

		local out = {}
		handled = {}
		for _, sg in ipairs(sgs) do
			handled[sg] = true
			collectSG(sg, mode, out)
		end

		if #out == 0 then
			setStatus("Nada para alterar (já está oculto?)")
			busy = false
			return
		end

		active = out
		for i, e in ipairs(active) do
			apply(e)
			if i % 400 == 0 then task.wait() end
		end

		hidden = true
		rr = 1
		startEnforce()
		styleToggle()
		if mode == "camuflar" then
			setStatus("Camuflados: " .. count .. " menu(s) + este script")
		else
			setStatus("Ocultos: " .. count .. " menu(s) de script")
		end
		busy = false
	end)
end

local function showNow(done)
	if busy or not hidden then return end
	busy = true
	hidden = false
	stopEnforce()
	task.spawn(function()
		for i, e in ipairs(active) do
			restore(e)
			if i % 400 == 0 then task.wait() end
		end
		active = {}
		handled = {}
		styleToggle()
		setStatus("Scripts visíveis")
		busy = false
		if done then done() end
	end)
end

track(toggleBtn.MouseButton1Click:Connect(function()
	setList(false)
	if busy then return end
	if hidden then showNow() else hideNow() end
end))

