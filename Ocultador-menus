task.spawn(function()
	local sgs = findScripts()
	if #sgs > 0 then
		setStatus("Detectados: " .. #sgs .. " menu(s) de script")
		local arc = {}
		for _, sg in ipairs(sgs) do
			if hasArceusContent(sg) then table.insert(arc, sg) end
		end
		if #arc > 0 then pcall(findLogoImage, arc) end
	else
		setStatus("Nenhum menu de script detectado ainda")
	end
end)

env.__OCS_CLEAN = function()
	hidden = false
	stopEnforce()
	for _, e in ipairs(active) do restore(e) end
	active = {}
	for _, c in ipairs(conns) do
		pcall(function() c:Disconnect() end)
	end
	pcall(function() gui:Destroy() end)
end
