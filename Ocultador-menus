local function refreshOptions()
	tw(optRemover, { BackgroundColor3 = (mode == "remover") and ACCENT or ACCENT_DARK }, 0.2, Enum.EasingStyle.Sine)
	tw(optCamo, { BackgroundColor3 = (mode == "camuflar") and ACCENT or ACCENT_DARK }, 0.2, Enum.EasingStyle.Sine)
	modeBtn.Text = (mode == "remover") and "Remover da tela" or "Camuflar (opacidade baixa)"
end

track(modeBtn.MouseButton1Click:Connect(function()
	setList(not listOpen)
end))

local function pickMode(m)
	setList(false)
	if m == mode then return end
	mode = m
	refreshOptions()
	if hidden then
		-- aplica o novo modo na hora
		showNow(function() hideNow() end)
	end
end

track(optRemover.MouseButton1Click:Connect(function() pickMode("remover") end))
track(optCamo.MouseButton1Click:Connect(function() pickMode("camuflar") end))
refreshOptions()

