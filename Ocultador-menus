local PANEL_HEIGHT = 0.42

-- o que vai ser ocultado (nomes em minusculo)
local DRIP_PREFIX = { "windui" }
local DRIP_CONTAINS = { "drip" }
local EXTRA_NAMES = {} -- ex: { ["MeuMenu"] = true }

local GREEN = Color3.fromRGB(46, 160, 110)
local RED = Color3.fromRGB(200, 60, 70)
local GREY = Color3.fromRGB(90, 90, 110)
