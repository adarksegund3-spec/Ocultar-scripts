local listOpen = false

local function closeListInstant()
	listOpen = false
	list.Visible = false
	list.Size = UDim2.new(1, -28, 0, 0)
	arrow.Rotation = 0
end

local function setList(open)
	if open == listOpen then return end
	listOpen = open
	if open then
		list.Visible = true
		tw(list, { Size = UDim2.new(1, -28, 0, 56) }, 0.28)
		tw(arrow, { Rotation = 180 }, 0.28)
	else
		tw(arrow, { Rotation = 0 }, 0.2)
		tw(list, { Size = UDim2.new(1, -28, 0, 0) }, 0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		task.delay(0.22, function()
			if not listOpen then list.Visible = false end
		end)
	end
end

local menuOpen = false
local menuToken = 0
local cardPosTween = nil

local function offsetPos(p, dy)
	return UDim2.new(p.X.Scale, p.X.Offset, p.Y.Scale, p.Y.Offset + dy)
end

local function openMenu()
	if menuOpen then return end
	menuOpen = true
	menuToken += 1

	card.Visible = true
	cardScale.Scale = 0.86
	card.GroupTransparency = 1
	card.Position = offsetPos(cardPos, 18)
	cardStroke.Transparency = 1

	cardPosTween = tw(card, { Position = cardPos }, 0.42, Enum.EasingStyle.Quint)
	tw(card, { GroupTransparency = 0 }, 0.42, Enum.EasingStyle.Quint)
	tw(cardScale, { Scale = 1 }, 0.5, Enum.EasingStyle.Back)
	tw(cardStroke, { Transparency = 0 }, 0.4, Enum.EasingStyle.Sine)
end

local function closeMenu()
	if not menuOpen then return end
	menuOpen = false
	menuToken += 1
	local token = menuToken

	closeListInstant()
	cardPosTween = tw(card, { Position = offsetPos(cardPos, 12) }, 0.24, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
	tw(card, { GroupTransparency = 1 }, 0.24, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
	tw(cardScale, { Scale = 0.92 }, 0.24, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
	tw(cardStroke, { Transparency = 1 }, 0.2, Enum.EasingStyle.Sine)

	task.delay(0.28, function()
		if menuToken == token and not menuOpen then
			card.Visible = false
		end
	end)
end

local function toggleMenu()
	if menuOpen then closeMenu() else openMenu() end
end

track(closeBtn.MouseButton1Click:Connect(closeMenu))

