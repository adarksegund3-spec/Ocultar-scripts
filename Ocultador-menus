local function getParents()
	local list = {}
	if typeof(gethui) == "function" then
		local ok, h = pcall(gethui)
		if ok and h then table.insert(list, h) end
	end
	table.insert(list, CoreGui)
	local lp = Players.LocalPlayer
	local pg = lp and lp:FindFirstChildOfClass("PlayerGui")
	if pg then table.insert(list, pg) end
	return list
end

-- onde ficam os menus de scripts (nunca o PlayerGui do jogo)
local function getExecRoots()
	local list, seen = {}, {}
	local function add(r)
		if r and not seen[r] then
			seen[r] = true
			table.insert(list, r)
		end
	end
	if typeof(gethui) == "function" then
		local ok, h = pcall(gethui)
		if ok then add(h) end
	end
	add(CoreGui)
	return list
end

for _, p in ipairs(getParents()) do
	pcall(function()
		for _, c in ipairs(p:GetChildren()) do
			if c:GetAttribute(TAG) then c:Destroy() end
		end
	end)
end

---------------------------------------------------------------------
-- Helpers de interface
---------------------------------------------------------------------
local conns = {}
local function track(c) table.insert(conns, c) return c end

local function tw(inst, props, dur, style, dir)
	local t = TweenService:Create(
		inst,
		TweenInfo.new(dur, style or Enum.EasingStyle.Quint, dir or Enum.EasingDirection.Out),
		props
	)
	t:Play()
	return t
end

local function corner(o, r)
	local c = Instance.new("UICorner")
	c.CornerRadius = r
	c.Parent = o
	return c
end

local function stroke(o, color, th)
	local s = Instance.new("UIStroke")
	s.Color = color
	s.Thickness = th
	s.Parent = o
	return s
end

local function label(parent, text, pos, size, ts, color, font)
	local l = Instance.new("TextLabel")
	l.BackgroundTransparency = 1
	l.Text = text
	l.Position = pos
	l.Size = size
	l.TextSize = ts
	l.TextColor3 = color
	l.Font = font or Enum.Font.Gotham
	l.TextWrapped = true
	l.Parent = parent
	return l
end

local function button(parent, text, pos, size, bg, ts)
	local b = Instance.new("TextButton")
	b.Text = text
	b.Position = pos
	b.Size = size
	b.BackgroundColor3 = bg
	b.BorderSizePixel = 0
	b.TextColor3 = Color3.new(1, 1, 1)
	b.Font = Enum.Font.GothamBold
	b.TextSize = ts
	b.AutoButtonColor = false
	b.Parent = parent
	corner(b, UDim.new(0, 8))
	return b
end

-- efeito de toque (afunda levemente e volta suave)
local function pressable(b)
	local sc = Instance.new("UIScale")
	sc.Parent = b
	track(b.MouseButton1Down:Connect(function()
		tw(sc, { Scale = 0.95 }, 0.08, Enum.EasingStyle.Quad)
	end))
	local function up()
		tw(sc, { Scale = 1 }, 0.25, Enum.EasingStyle.Back)
	end
	track(b.MouseButton1Up:Connect(up))
	track(b.MouseLeave:Connect(up))
end

